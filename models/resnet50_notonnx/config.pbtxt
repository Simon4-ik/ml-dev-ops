name: "resnet50_notonnx"
platform: "pytorch_libtorch"
max_batch_size: 16

dynamic_batching {
  max_queue_delay_microseconds: 5000
}

input [
  {
    name: "input__0"
    data_type: TYPE_FP32
    format: FORMAT_NCHW
    dims: [ 3, 224, 224 ]
  }
]

output [
  {
    name: "output__0"
    data_type: TYPE_FP32
    dims: [ 1000 ]
  }
]
